  "MMA": {
   "first": "CC(C)(C(=O)OC)[*]",
   "middle": "[*]CC([*])(C)C(=O)OC",
   "last": "[*]CC(C)C(=O)OC"
  },
  "DMS": {
   "first": "C[Si](C)(C)O[*]",
   "middle": "[*][Si](C)(C)O[*]",
   "last": "[*][Si](C)(C)C"
  },
  "VAC": {
