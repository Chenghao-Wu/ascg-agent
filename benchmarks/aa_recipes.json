{
 "benchmark": "ascg benchmark v1",
 "version": 2,
 "date": "2026-10-26",
 "provenance": "AA build recipes of the ascg benchmark v1 (40 systems). Conventions: AutoPoly v2.0 complement SMILES; the last [*] of unit i bonds to the first [*] of unit i+1; first / last units carry the end groups (implicit H fill); middle units list the head (CH2) [*] first for head-to-tail vinyl chains; atactic vinyl chains of 10 repeat units (9 for the periodic EVA); every polymer task gives its chain count (about 1000 CG beads, at least 20 chains); liquids one capped molecule per AutoPoly \"polymer\", 1000 molecules, the mixture 500 + 500. State points and equilibration per class: polymers EQ21 at 500 K, then 400 / 500 K branches at 1 atm; liquids direct equilibration and one state, 300 K at 1 atm.",
 "defaults": {
  "repeat_units": 10,
  "tacticity": "atactic",
  "target_cg_beads": 1000,
  "molecules": 1000
 },
 "states": {
  "polymer": "400,500",
  "liquid": "300",
  "liquid_mixture": "300"
 },
 "equilibration": {
  "polymer": "eq21",
  "liquid": "direct",
  "liquid_mixture": "direct"
 },
 "units": {
