   "middle": "[*]CC=CC[*]",
   "last": "[*]CC=CC"
  },
  "IP": {
   "first": "CC(C)=CC[*]",
   "middle": "[*]CC(C)=CC[*]",
   "last": "[*]CC(C)=CC"
  },
  "DMBD": {
