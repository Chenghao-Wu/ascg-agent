   "middle": "[*]CC([*])OC(C)=O",
   "last": "[*]CC(OC(C)=O)"
  },
  "NBA": {
   "first": "CC(C(=O)OCCCC)[*]",
   "middle": "[*]CC([*])C(=O)OCCCC",
   "last": "[*]CC(C(=O)OCCCC)"
  },
  "BPC": {
   "first": "COC(=O)Oc1ccc(C(C)(C)c2ccc([*])cc2)cc1",
   "middle": "[*]OC(=O)Oc1ccc(C(C)(C)c2ccc([*])cc2)cc1",
   "last": "[*]OC(=O)Oc1ccc(C(C)(C)c2ccccc2)cc1"
  },
  "ETT": {
   "first": "OCCOC(=O)c1ccc(cc1)C(=O)[*]",
   "middle": "[*]OCCOC(=O)c1ccc(cc1)C(=O)[*]",
   "last": "[*]OCCOC(=O)c1ccc(cc1)C(=O)OC"
  }
 },
 "notes": {
  "stereo": "AutoPoly drops SMILES chirality and E/Z marks for every unit after the first; tacticity comes from the Polymer tacticity argument (z-mirrored unit variants), and diene cis/trans is whatever the ETKDG unit embedding gives. Measure and report the built microstructure; it is not set here.",
  "dienes": "1,4-addition units for PBD, PI, P2,3-DMBD and PCR (AutoPoly's own PB/PI examples are not 1,4 units).",
  "pla": "Methyl-capped (CH3O- start, -C(=O)OCH3 end) instead of HO-/-COOH: AutoPoly types the COOH carbon as an alcohol carbon (chain charge -0.32 e).",
  "pcl": "Polycaprolactam = nylon-6, acetyl / N-methylamide caps so every end is an amide.",
  "ep": "Composition: 50:50 mol, an independent Bernoulli sequence per chain from the build seed.",
  "eva_periodic": "(E-E-VA)x3 = 9 repeat units.",
  "pvdf": "Last unit methyl-capped (-CH2-CF2-CH3): OPLS has no neutral CHF2 end group.",
  "typing": "OPLS typing additions in patches/opls_lt_2024_ascg_additions.fdefn (carbinol H, amide N-C H, aliphatic fluorides).",
  "charge_fix": "Where OPLS has no neutral type set, the listed OPLS types (the carbon bonded to the heteroatom) absorb each chain's residual charge uniformly; see ascg neutralize-aa.",
  "end_groups": "PMMA / PVAc / PnBA: H-terminated (CH3- start, -CH2-CH(X)H end) as the 27 vinyl tasks; PDMS: trimethylsilyl ends, Me3Si-O-(Me2SiO)8-SiMe3; BPA-PC: methyl carbonate start, phenyl end; PET: 2-hydroxyethyl ester start, methyl ester end (a COOH end is typed as an alcohol carbon by AutoPoly, as found for PLA).",
  "pdms": "Force field: OPLS-AA with the PDMS benchmark's Qeq charges and Si-O terms (Xiang et al., J. Phys. Chem. B 2025; github.com/COMO-lab/PDMS_benchmark), benchmarks/ff/pdms_oplsaa_xiang2025.json, applied to the converted topology (prepare-gmx-protocol --ff-override). AutoPoly types the siloxane with OPLS-2024 Si silyl-ether types only to build the structure; the build's temporary neutralization on Si 1075 is superseded by the override charges.",
  "mixture": "500 n-hexane + 500 toluene (x = 0.5) is the spec's illustrative composition, not an approved default.",
  "bpa_pc_charges": "OPLS-AA has no diaryl carbonate C: the carbonate C is typed as the aryl-ester carbonyl 471 (+0.605), which leaves +0.035 e per carbonate; ascg neutralize-aa moves it onto the carbonate C (+0.570). A force-field adjustment, reported to the user.",
  "typing_patch": "patches/opls_lt_2024_ascg_additions.fdefn, ester and nitrile section: ester alkoxy CH2 490, aromatic carboxylate ester C 471, acetonitrile CH3 755 (standard OPLS-AA types)."
 },
